# ──────────────────────────────────────────────────────────────────────────────
# .env.example – copy to .env and fill in your values, or export directly
# ──────────────────────────────────────────────────────────────────────────────

# Hugging Face access token (required for pyannote diarization)
# Get one at: https://huggingface.co/settings/tokens
HF_TOKEN=hf_paste_your_token_here

# ── Optional settings (defaults shown) ──────────────────────────────────────

# WhisperX model size: tiny, base, small, medium, large-v2, large-v3, large-v3-turbo
# Recommended for RTX 3070 (8 GB VRAM): large-v3-turbo
WHISPER_MODEL=large-v3-turbo

# Device: cpu or cuda
DEVICE=cuda

# Compute/quantisation type: float16 for GPU, float32/int8 for CPU
COMPUTE_TYPE=float16

# Language passed to Whisper (ISO 639-1). e.g. "pt", "en".
# Leave empty to auto-detect.
WHISPER_LANGUAGE=pt

# WhisperX batch size (reduce to 8 or 4 if you get OOM errors)
BATCH_SIZE=16

# ── GUI recorder settings ───────────────────────────────────────────────────

# PulseAudio mic source (find with: pactl list sources short)
# RECORDER_MIC=alsa_input.usb-Logitech_G522_LIGHTSPEED_-_Wireless_Mode_0000000000000000-00.mono-fallback

# PulseAudio desktop monitor source
# RECORDER_MONITOR=alsa_output.usb-Logitech_G522_LIGHTSPEED_-_Wireless_Mode_0000000000000000-00.analog-stereo.monitor

# Output directory for recordings
# RECORDER_OUTPUT_DIR=~/recordings
