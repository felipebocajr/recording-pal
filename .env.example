# ──────────────────────────────────────────────────────────────────────────────
# .env.example – copy this file to .env and fill in your values
# ──────────────────────────────────────────────────────────────────────────────

# Discord bot token (from https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Hugging Face access token (from https://huggingface.co/settings/tokens)
HF_TOKEN=hf_your_token_here

# ── Optional settings (defaults shown) ──────────────────────────────────────

# WhisperX model size: tiny, base, small, medium, large-v2, large-v3
WHISPER_MODEL=base

# Device: cpu or cuda
DEVICE=cpu

# Compute/quantisation type: auto, float16, int8, float32
COMPUTE_TYPE=auto

# WhisperX batch size (reduce if you get OOM errors)
BATCH_SIZE=16
